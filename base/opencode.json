{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.4",
  "mode": {
    "plan": {
      "model": "openai/gpt-5.4"
    },
    "build": {
      "model": "openai/gpt-5.4"
    }
  },
  "provider": {
    "openai": {
      "name": "OpenAI",
      "options": {
        "apiKey": "{env:OPENAI_API_KEY}",
        "reasoningEffort": "high"
      },
      "models": {
        "gpt-5.3-codex": {
          "name": "GPT-5.3-Codex"
        },
        "gpt-5.4": {
          "name": "GPT-5.4"
        },
        "gpt-5.4-mini": {
          "name": "GPT-5.4 mini"
        },
        "gpt-5.4-nano": {
          "name": "GPT-5.4 nano"
        },
        "gpt-5.4-pro-2026-03-05": {
          "name": "GPT-5.4 pro"
        }
      }
    },
    "parasail": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Parasail",
      "options": {
        "baseURL": "https://api-webflux.saas.parasail.io/v1",
        "apiKey": "{env:PARASAIL_API_KEY}"
      },
      "models": {
        "parasail-glm-5": {
          "name": "GLM-5"
        },
        "parasail-glm47": {
          "name": "GLM-4.7"
        },
        "parasail-glm-46v": {
          "name": "GLM-4.6V",
          "attachment": true
        },
        "parasail-minimax-m25": {
          "name": "MiniMax M2.5"
        },
        "parasail-deepseek-v32": {
          "name": "DeepSeek V3.2"
        },
        "parasail-qwen35-397b-a17b": {
          "name": "Qwen3.5 397B A17B"
        },
        "parasail-qwen3-235b-a22b-instruct-2507": {
          "name": "Qwen3 235B A22B Instruct"
        },
        "parasail-kimi-k25": {
          "name": "Kimi K2.5 (262k ctx)"
        },
        "parasail-kimi-k2-instruct": {
          "name": "Kimi K2 (262k ctx)"
        },
        "parasail-kimi-k2-thinking": {
          "name": "Kimi K2 (262k ctx)"
        },
        "parasail-mistral-small-32-24b": {
          "name": "Mistral Small (Fast)"
        }
      }
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    },
    "tavily": {
      "type": "remote",
      "url": "https://mcp.tavily.com/mcp",
      "headers": {
        "Authorization": "Bearer {env:TAVILY_API_KEY}"
      },
      "enabled": true
    }
  }
}